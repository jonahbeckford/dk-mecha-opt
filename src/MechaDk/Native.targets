<Project>
  <!--
    Builds native/mechadk_native.c with CMake as part of `dotnet build`. It stands in for the OCaml
    code to come, which will be built as a DLL, a static library and WebAssembly.

    Desktop is built for the HOST only (no cross compiler is assumed), so publishing a desktop RID
    for another OS or architecture fails early rather than shipping an app without its library.
    Pass MechaDkNativeCMakeArgs to hand CMake a cross toolchain.
  -->
  <PropertyGroup>
    <MechaDkNativeSrc>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'native'))</MechaDkNativeSrc>
    <MechaDkNativeObj>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'obj', 'native'))</MechaDkNativeObj>
    <MechaDkNativeBuildType Condition="'$(Configuration)' == 'Debug'">Debug</MechaDkNativeBuildType>
    <MechaDkNativeBuildType Condition="'$(MechaDkNativeBuildType)' == ''">Release</MechaDkNativeBuildType>
    <MechaDkAndroidAbis Condition="'$(MechaDkAndroidAbis)' == ''">arm64-v8a;x86_64</MechaDkAndroidAbis>

    <_MechaDkHostOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</_MechaDkHostOs>
    <_MechaDkHostOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_MechaDkHostOs>
    <_MechaDkHostOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_MechaDkHostOs>
    <_MechaDkHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_MechaDkHostArch>
    <_MechaDkHostRid>$(_MechaDkHostOs)-$(_MechaDkHostArch)</_MechaDkHostRid>
  </PropertyGroup>

  <ItemGroup>
    <MechaDkNativeInput Include="$(MechaDkNativeSrc)CMakeLists.txt;$(MechaDkNativeSrc)*.c;$(MSBuildThisFileFullPath)" />
  </ItemGroup>

  <!-- ===== desktop: shared library for the host ===== -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <_MechaDkDesktopRid>$(RuntimeIdentifier)</_MechaDkDesktopRid>
    <_MechaDkDesktopRid Condition="'$(_MechaDkDesktopRid)' == ''">$(_MechaDkHostRid)</_MechaDkDesktopRid>
    <_MechaDkDesktopDir>$(MechaDkNativeObj)desktop/$(_MechaDkDesktopRid)/</_MechaDkDesktopDir>
  </PropertyGroup>

  <!-- Always runs (no Inputs/Outputs), so a skipped incremental build cannot hide the error. -->
  <Target Name="MechaDkNativeDesktopGuard"
          BeforeTargets="AssignTargetPaths;_ComputeResolvedCopyLocalPublishAssets"
          Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <Error Condition="'$(_MechaDkDesktopRid)' != '$(_MechaDkHostRid)' and !($(_MechaDkDesktopRid.StartsWith('osx')) and '$(_MechaDkHostOs)' == 'osx')"
           Text="The native library is built for the host only ($(_MechaDkHostRid)), so $(_MechaDkDesktopRid) cannot be built here. Build $(_MechaDkDesktopRid) on that OS and architecture (see README)." />
  </Target>

  <Target Name="MechaDkNativeDesktop"
          DependsOnTargets="MechaDkNativeDesktopGuard"
          BeforeTargets="AssignTargetPaths;_ComputeResolvedCopyLocalPublishAssets"
          Condition="'$(TargetFramework)' == 'net10.0-desktop'"
          Inputs="@(MechaDkNativeInput)"
          Outputs="$(_MechaDkDesktopDir)stamp">
    <PropertyGroup>
      <_OsxArch Condition="$(_MechaDkDesktopRid.EndsWith('x64'))">x86_64</_OsxArch>
      <_OsxArch Condition="$(_MechaDkDesktopRid.EndsWith('arm64'))">arm64</_OsxArch>
      <_OsxArg Condition="'$(_MechaDkHostOs)' == 'osx'">-DCMAKE_OSX_ARCHITECTURES=$(_OsxArch)</_OsxArg>
    </PropertyGroup>
    <Exec Command="cmake -S &quot;$(MechaDkNativeSrc)&quot; -B &quot;$(_MechaDkDesktopDir)&quot; -DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=$(MechaDkNativeBuildType) -DMECHADK_OUTPUT_DIR=&quot;$(_MechaDkDesktopDir)out&quot; $(_OsxArg) $(MechaDkNativeCMakeArgs)" />
    <Exec Command="cmake --build &quot;$(_MechaDkDesktopDir)&quot; --config $(MechaDkNativeBuildType)" />
    <Touch Files="$(_MechaDkDesktopDir)stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="MechaDkNativeDesktopItems"
          DependsOnTargets="MechaDkNativeDesktop"
          BeforeTargets="AssignTargetPaths;_ComputeResolvedCopyLocalPublishAssets"
          Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <PropertyGroup>
      <_LibName Condition="'$(_MechaDkHostOs)' == 'win'">mechadk_native.dll</_LibName>
      <_LibName Condition="'$(_MechaDkHostOs)' == 'osx'">libmechadk_native.dylib</_LibName>
      <_LibName Condition="'$(_MechaDkHostOs)' == 'linux'">libmechadk_native.so</_LibName>
      <_Lib>$(_MechaDkDesktopDir)out/$(_LibName)</_Lib>
    </PropertyGroup>
    <ItemGroup>
      <!-- Treated like a package's native asset, so a single-file publish bundles it. -->
      <ReferenceCopyLocalPaths Include="$(_Lib)" AssetType="native" DestinationSubDirectory="" />
    </ItemGroup>
  </Target>

  <!-- ===== Android: shared library per ABI, built with the NDK toolchain ===== -->
  <Target Name="MechaDkNativeAndroid"
          BeforeTargets="_ResolveAssemblies;_GenerateJavaStubs;_BuildApkEmbed"
          Condition="'$(TargetFramework)' == 'net10.0-android'"
          Inputs="@(MechaDkNativeInput)"
          Outputs="$(MechaDkNativeObj)android/stamp">
    <PropertyGroup>
      <_Ndk>$(ANDROID_NDK_ROOT)</_Ndk>
      <_Ndk Condition="'$(_Ndk)' == ''">$(ANDROID_NDK_HOME)</_Ndk>
      <_Ndk Condition="'$(_Ndk)' == ''">$(AndroidNdkDirectory)</_Ndk>
    </PropertyGroup>
    <Error Condition="'$(_Ndk)' == '' or !Exists('$(_Ndk)/build/cmake/android.toolchain.cmake')"
           Text="The Android NDK was not found. Set ANDROID_NDK_ROOT (scripts/setup-dev-machine.ps1 installs it)." />
    <ItemGroup>
      <_Abi Include="$(MechaDkAndroidAbis)" />
    </ItemGroup>
    <Exec Command="cmake -S &quot;$(MechaDkNativeSrc)&quot; -B &quot;$(MechaDkNativeObj)android/%(_Abi.Identity)&quot; -G Ninja -DCMAKE_TOOLCHAIN_FILE=&quot;$(_Ndk)/build/cmake/android.toolchain.cmake&quot; -DANDROID_ABI=%(_Abi.Identity) -DANDROID_PLATFORM=android-21 -DANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES=ON -DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=$(MechaDkNativeBuildType) -DMECHADK_OUTPUT_DIR=&quot;$(MechaDkNativeObj)android/%(_Abi.Identity)/out&quot; $(MechaDkNativeCMakeArgs)" />
    <Exec Command="cmake --build &quot;$(MechaDkNativeObj)android/%(_Abi.Identity)&quot;" />
    <Touch Files="$(MechaDkNativeObj)android/stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="MechaDkNativeAndroidItems"
          DependsOnTargets="MechaDkNativeAndroid"
          BeforeTargets="_ResolveAssemblies;_GenerateJavaStubs;_BuildApkEmbed"
          Condition="'$(TargetFramework)' == 'net10.0-android'">
    <ItemGroup>
      <_Abi2 Include="$(MechaDkAndroidAbis)" />
      <AndroidNativeLibrary Include="$(MechaDkNativeObj)android/%(_Abi2.Identity)/out/libmechadk_native.so" Abi="%(_Abi2.Identity)" />
    </ItemGroup>
  </Target>

  <!-- ===== iOS (macOS host only): static library linked into the app ===== -->
  <Target Name="MechaDkNativeIos"
          BeforeTargets="_CollectNativeReferences;_ComputeNativeReferences;_PrepareNativeReferences"
          Condition="'$(TargetFramework)' == 'net10.0-ios'"
          Inputs="@(MechaDkNativeInput)"
          Outputs="$(MechaDkNativeObj)ios/stamp">
    <PropertyGroup>
      <_IosSdk>iphoneos</_IosSdk>
      <_IosSdk Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">iphonesimulator</_IosSdk>
      <_IosArch>arm64</_IosArch>
      <_IosArch Condition="$(RuntimeIdentifier.EndsWith('x64'))">x86_64</_IosArch>
    </PropertyGroup>
    <Exec Command="cmake -S &quot;$(MechaDkNativeSrc)&quot; -B &quot;$(MechaDkNativeObj)ios&quot; -G Ninja -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_OSX_SYSROOT=$(_IosSdk) -DCMAKE_OSX_ARCHITECTURES=$(_IosArch) -DBUILD_SHARED_LIBS=OFF -DCMAKE_BUILD_TYPE=$(MechaDkNativeBuildType) -DMECHADK_OUTPUT_DIR=&quot;$(MechaDkNativeObj)ios/out&quot; $(MechaDkNativeCMakeArgs)" />
    <Exec Command="cmake --build &quot;$(MechaDkNativeObj)ios&quot;" />
    <Touch Files="$(MechaDkNativeObj)ios/stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="MechaDkNativeIosItems"
          DependsOnTargets="MechaDkNativeIos"
          BeforeTargets="_CollectNativeReferences;_ComputeNativeReferences;_PrepareNativeReferences"
          Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <ItemGroup>
      <NativeReference Include="$(MechaDkNativeObj)ios/out/libmechadk_native.a" Kind="Static" ForceLoad="true" />
    </ItemGroup>
  </Target>

  <!-- ===== WebAssembly: static library built with the emscripten toolchain from the wasm-tools workload ===== -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <Target Name="MechaDkNativeWasm"
          DependsOnTargets="_SetupEmscripten"
          BeforeTargets="_PrepareForBrowserWasmBuildNative;_WasmCalculatePInvokeTableFile"
          Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <PropertyGroup>
      <_EmCmake>$(EmscriptenSdkToolsPath)emscripten/cmake/Modules/Platform/Emscripten.cmake</_EmCmake>
      <_Dir>$(MechaDkNativeObj)wasm/</_Dir>
    </PropertyGroup>
    <ItemGroup>
      <!-- The SDK adds the cache variables later, inside _PrepareForBrowserWasmBuildNative. -->
      <_EmEnv Include="@(EmscriptenEnvVars)" />
      <_EmEnv Include="EM_CACHE=$(EmscriptenCacheSdkCacheDir)" />
      <_EmEnv Include="EM_FROZEN_CACHE=1" />
    </ItemGroup>
    <Exec Command="cmake -S &quot;$(MechaDkNativeSrc)&quot; -B &quot;$(_Dir)&quot; -G Ninja -DCMAKE_TOOLCHAIN_FILE=&quot;$(_EmCmake)&quot; -DBUILD_SHARED_LIBS=OFF -DCMAKE_BUILD_TYPE=Release -DMECHADK_OUTPUT_DIR=&quot;$(_Dir)out&quot; $(MechaDkNativeCMakeArgs)"
          EnvironmentVariables="@(_EmEnv)" />
    <Exec Command="cmake --build &quot;$(_Dir)&quot;" EnvironmentVariables="@(_EmEnv)" />
    <ItemGroup>
      <NativeFileReference Include="$(_Dir)out/libmechadk_native.a" />
    </ItemGroup>
  </Target>
</Project>
